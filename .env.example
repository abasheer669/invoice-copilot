# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# Local Postgres from compose.yaml (`docker compose up -d --wait`)
DATABASE_URL=postgresql://ap_app:ap_app@127.0.0.1:5433/ap_agent

# Model configuration (swappable; nothing else names a provider)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# EMBED_PROVIDER=fake gives offline hashed bag-of-words vectors, for tests
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Policy corpus and the queries every new index must answer before it goes live
CORPUS_SOURCE=data/corpus
GOLDEN_QUERIES=data/golden_queries.yaml

# Budgets
MAX_STEPS=12
MAX_TOOL_CALLS=8

# Tool reliability
TOOL_TIMEOUT_S=3
TOOL_MAX_RETRIES=2

# Retrieval relevance threshold (cosine similarity). Calibrated for gemini-embedding-001
# at 768-d; recalibrate if you change the embedding model.
RETRIEVAL_MIN_SCORE=0.6

# Fault injection: comma-separated tool:kind, e.g. get_purchase_order:timeout
# timeout = every attempt hangs past the deadline; transient = the first attempt fails
FAULTS=
